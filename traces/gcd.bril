# ARGS: 5 35
@main(op1: int, op2: int) {
  speculate;
  vc0: int = const 0;
  v0: int = id op1;
  v1: int = id op2;
  v2: bool = lt v0 v1;
  __guard_cond__0: bool = const true;
  guard __guard_cond__0 .__speculate_aborted;
  v3: int = sub v1 v0;
  v4: bool = eq v3 vc0;
  __guard_cond__1: bool = const false;
  guard __guard_cond__1 .__speculate_aborted;
  __guard_cond__2: bool = const true;
  guard __guard_cond__2 .__speculate_aborted;
  v1: int = id v3;
  v2: bool = lt v0 v1;
  __guard_cond__3: bool = const true;
  guard __guard_cond__3 .__speculate_aborted;
  commit;
  jmp .__speculate_done;
.__speculate_aborted:
  vc0: int = const 0;
  v0: int = id op1;
  v1: int = id op2;
.cmp.val:
  v2: bool = lt v0 v1;
.__speculate_done:
  br v2 .if.1 .else.1;
.if.1:
  v3: int = sub v1 v0;
  jmp .loop.bound;
.else.1:
  v3: int = sub v0 v1;
  jmp .loop.bound;
.loop.bound:
  v4: bool = eq v3 vc0;
  br v4 .program.end .update.val;
.update.val:
  br v2 .if.2 .else.2;
.if.2:
  v1: int = id v3;
  jmp .cmp.val;
.else.2:
  v0: int = id v3;
  jmp .cmp.val;
.program.end:
  print v1;
}
