# ARGS: 16
@main(input: int) {
  speculate;
  one: int = const 1;
  zero: int = const 0;
  cur: int = const 1;
  square: int = mul cur cur;
  commit;
  jmp .__speculate_done;
.__speculate_aborted:
  one: int = const 1;
  zero: int = const 0;
  cur: int = const 1;
.print:
  square: int = mul cur cur;
.__speculate_done:
  print square;
  isdone: bool = eq cur input;
  cur: int = add cur one;
  br isdone .done .print;
.done:
}
